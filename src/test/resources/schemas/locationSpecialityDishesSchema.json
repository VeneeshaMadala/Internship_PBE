{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["description", "dishes", "message"],
  "properties": {
    "description": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "dishes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "price", "weight", "imageUrl", "isPopular", "isSpeciality"],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "price": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "weight": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "imageUrl": {
            "type": "string",
            "format": "uri"
          },
          "isPopular": {
            "type": "boolean"
          },
          "isSpeciality": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
