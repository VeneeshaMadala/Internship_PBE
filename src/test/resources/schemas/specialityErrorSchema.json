{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ErrorResponse",
  "type": "object",
  "required": ["description", "message", "status"],
  "properties": {
    "description": {
      "type": "string",
      "example": "We couldn't find the location you're looking for."
    },
    "message": {
      "type": "string",
      "example": "Location not found"
    },
    "status": {
      "type": "integer",
      "example": 404
    }
  },
  "additionalProperties": false
}
