{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "address", "description", "totalCapacity", "averageOccupancy", "imageUrl"],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^loc-[0-9]{3}$"
      },
      "address": {
        "type": "string",
        "minLength": 1
      },
      "description": {
        "type": "string",
        "minLength": 1
      },
      "totalCapacity": {
        "type": "string",
        "pattern": "^[0-9]+$"
      },
      "averageOccupancy": {
        "type": "string",
        "pattern": "^[0-9]+$"
      },
      "imageUrl": {
        "type": "string",
        "format": "uri"
      }
    },
    "additionalProperties": false
  }
}
